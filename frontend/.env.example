# Choose ONE provider and set its key. Only fill in the section you use.

# "gemini", "anthropic", or "openai"
AI_PROVIDER=openai
# Optional: run answer extraction (bounding-box detection + handwriting OCR +
# question matching — the hardest step in the pipeline) on a *different*
# provider than the rest of the app. Useful if one provider's free tier is
# unreliable specifically for this step. Needs that provider's own API key
# set below too. Leave blank to use AI_PROVIDER for everything.
ANSWER_PROVIDER=

# --- Google Gemini (https://aistudio.google.com/apikey) — has a free tier ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: model used specifically for answer extraction (bounding-box
# detection + handwriting OCR + question matching) — the hardest step in the
# pipeline. Falls back to GEMINI_MODEL if unset. Worth setting to a stronger
# model than GEMINI_MODEL if you're using a Lite/distilled model above to
# stretch free-tier rate limits, since Lite models can silently return empty
# results on this step rather than erroring.
GEMINI_ANSWER_MODEL=

# --- Anthropic Claude (https://console.anthropic.com/) — trial credits only ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- OpenAI (https://platform.openai.com/api-keys) — trial credits only ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Mistral (https://console.mistral.ai/api-keys) — genuine free tier
# (not trial credits), includes Pixtral vision at no cost, but capped at a
# low RPM (~2/min reported) — best suited for ANSWER_PROVIDER rather than
# AI_PROVIDER, relying on the retry/backoff in lib/ai/mistral.ts. ---
MISTRAL_API_KEY=
MISTRAL_MODEL=pixtral-12b-2409
