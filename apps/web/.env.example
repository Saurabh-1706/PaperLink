# Copy to .env.local for `next dev`. Set the same names in the Vercel project's
# Environment Variables for deploys (see docs/08-deployment.md).

# --- MongoDB (Atlas) --------------------------------------------------------
# Atlas is always a replica set, even on the free tier, so real multi-document
# transactions are available (lib/server/db/session.ts uses them directly).
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=assessment
GRIDFS_BUCKET=documents

# --- Gemini ------------------------------------------------------------------
GEMINI_API_KEY=
# Ordered fallback list: on a 429/quota error the caller moves to the next
# model. Edit freely as Google renames/deprecates models -- nothing else in
# the code changes when this list does.
GEMINI_MODEL_CASCADE=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Empty = reuse GEMINI_MODEL_CASCADE for vision (OCR) calls too.
GEMINI_VISION_MODEL_CASCADE=
# After a quota/rate-limit refusal, stop calling that specific model for this
# long (process-local) before trying it again.
LLM_QUOTA_COOLDOWN_SECONDS=900
# Same idea for a model that answered 404/403 (retired id, or no access with this
# key). Longer, because unlike a rate limit that does not clear on its own — the
# cascade just skips it and uses the next model in the list.
LLM_UNAVAILABLE_COOLDOWN_SECONDS=3600
# Client-side pacing per model so a burst of page-OCR calls never exceeds the
# provider's own free-tier rpm cap in the first place.
LLM_REQUESTS_PER_MINUTE=15

# --- Rendering / uploads ------------------------------------------------------
RENDER_DPI=200
RENDER_MAX_LONG_EDGE=2000
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=200
SEARCHABLE_COVERAGE_THRESHOLD=0.02
BLOCK_CONFIDENCE_THRESHOLD=0.60

# --- Auth ----------------------------------------------------------------
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600
