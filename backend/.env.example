ENVIRONMENT=local
LOG_LEVEL=INFO

MONGO_URI=mongodb://host.docker.internal:27017/?directConnection=true
MONGO_DB_NAME=assessment
# MongoDB runs on the host (Windows service), not in compose. The host mongod is a
# standalone server, so multi-document transactions are unavailable -> false.
# Running the API outside Docker? Use mongodb://localhost:27017/?directConnection=true
MONGO_TRANSACTIONS=false
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

STORAGE_BACKEND=gridfs
GRIDFS_BUCKET=documents
# Only used when STORAGE_BACKEND=local.
STORAGE_PATH=/data/storage

# Providers are selected by config, never by import (ADR-004).
# gemini | groq | openai (no adapter yet -> behaves as null) | null
LLM_PROVIDER=groq
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-latest

# Groq. Model ids are deprecated often -- confirm with
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_API_KEY=
# Verify ids against your own key: not every account is served every model.
GROQ_MODEL=openai/gpt-oss-120b
# Must be multimodal (handwriting validation). Empty disables Groq vision.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Vision can run on a different provider from text; "auto" follows LLM_PROVIDER.
VISION_PROVIDER=auto

# A spent daily quota should not cost a retry backoff on every later call.
LLM_MAX_ATTEMPTS=2
LLM_QUOTA_COOLDOWN_SECONDS=900
# paddle (containerised deployment) | rapid (ONNX, pip-installable) | stub (tests)
OCR_ENGINE=rapid

# --- OCR preprocessing ---
# Divide out the illumination field (paper colour, shadow gradient, camera vignette)
# instead of a single global histogram remap. Moves no pixels, so coordinates are
# unaffected. A/B it with tests/eval before flipping this on.
OCR_FLATTEN_BACKGROUND=false
OCR_FLATTEN_RADIUS=16
# Separate flag on purpose: binarisation erases faint pencil, which is the stroke class
# handwriting extraction depends on. Do not enable without a measured A/B.
OCR_ADAPTIVE_THRESHOLD=false

# --- Line script routing ---
# off | telemetry (classify and log, route nothing) | route (act on the verdict)
LINE_SCRIPT_MODE=telemetry
LINE_SCRIPT_HANDWRITING_THRESHOLD=0.55

# --- Handwriting line recogniser ---
# none | trocr | stub. TrOCR decodes autoregressively (~0.4-1.2 s/line on CPU): leave
# this "none" unless the worker has a GPU, or it costs more than the vision call it
# replaces. Requires `pip install torch transformers` -- neither is in requirements.txt.
LINE_RECOGNIZER=none
TROCR_MODEL=microsoft/trocr-base-handwritten
TROCR_BATCH_SIZE=8
TROCR_DEVICE=cpu
TROCR_MAX_NEW_TOKENS=64
# A line at or above this OCR confidence is never overwritten by the recogniser.
TROCR_HIGH_CONFIDENCE_FLOOR=0.80

RENDER_DPI=300
RENDER_MAX_LONG_EDGE=3000
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=200

JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600

# Tuned from the eval suite, not guessed.
BLOCK_CONFIDENCE_THRESHOLD=0.60
QUESTION_CONFIDENCE_THRESHOLD=0.70
ANSWER_CONFIDENCE_THRESHOLD=0.65
MAPPING_ACCEPT_THRESHOLD=0.70
MAPPING_REVIEW_THRESHOLD=0.45
MAPPING_AMBIGUOUS_MARGIN=0.10
